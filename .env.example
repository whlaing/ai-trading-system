# ============================================================
# ATS Configuration Example
# Copy to .env and fill in real values.
# NEVER commit the real .env to version control.
# ============================================================

# --- Runtime Mode ---
TRADING_MODE=PAPER                    # BACKTEST | PAPER | LIVE
TRADING_ENABLED=true                  # Global kill switch

# --- IBKR Connection ---
IBKR_HOST=127.0.0.1
IBKR_PORT_PAPER=7497                  # TWS paper trading port
IBKR_PORT_LIVE=7496                   # TWS live trading port (do not use in PAPER mode)
IBKR_CLIENT_ID=1

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ats:ats@localhost:5432/ats

# --- AWS ---
AWS_REGION=ap-southeast-1
AWS_SNS_TOPIC_ARN=                    # arn:aws:sns:... — leave blank to disable notifications

# --- AI ---
ANTHROPIC_API_KEY=                    # sk-ant-...
AI_MODEL=claude-sonnet-5
AI_ENABLED=true

# --- Market Universe (comma-separated) ---
UNIVERSE=SPY,QQQ,AAPL,MSFT,AMZN,GOOGL,META,NVDA

# --- Risk Parameters (PAPER defaults — conservative) ---
MAX_OPEN_POSITIONS=3
MAX_POSITION_VALUE_USD=500
MAX_RISK_PER_TRADE_USD=5
MAX_DAILY_LOSS_USD=25
MAX_DAILY_TRADES=10

# --- Strategy Parameters ---
EMA_SHORT=20
EMA_LONG=50
RSI_MIN=40
RSI_MAX=70
RELATIVE_VOLUME_MIN=1.5
ATR_MAX_PCT=0.03

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
