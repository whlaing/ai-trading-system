# ============================================================
#  ATS — Local Paper Trading Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to git.
# ============================================================

# ── Trading Mode ────────────────────────────────────────────
# BACKTEST  = offline backtest only (no IBKR needed)
# PAPER     = live paper trading via IBKR paper account
# LIVE      = real money (locked until TRADING_ENABLED=true)
TRADING_MODE=PAPER
TRADING_ENABLED=true

# ── Database ────────────────────────────────────────────────
# SQLite (zero-install, great for local dev & paper trading):
DATABASE_URL=sqlite:///ats.db

# PostgreSQL (recommended for production / persistent data):
# Step 1: brew install postgresql@16 && brew services start postgresql@16
# Step 2: createdb ats && createuser ats --pwprompt
# Step 3: uncomment the line below and comment out the SQLite line above
# DATABASE_URL=postgresql+psycopg2://ats:ats@localhost:5432/ats

DATABASE_ECHO=false

# ── IBKR Connection ─────────────────────────────────────────
# IBKR does NOT use API keys — it connects to TWS or IB Gateway
# running locally on your machine.
#
# Setup steps:
#   1. Download IB Gateway (smaller) or TWS from interactivebrokers.com
#   2. Log in with your IBKR paper trading account credentials
#   3. Go to: Configure → Settings → API → Settings
#      ✓ Enable ActiveX and Socket Clients
#      ✓ Socket port: 7497  (paper TWS) or 4002 (paper IB Gateway)
#      ✓ Allow connections from localhost only
#   4. Keep TWS/Gateway running while the trader is active
#
IBKR_HOST=127.0.0.1
IBKR_PORT_PAPER=7497        # TWS paper trading port
IBKR_PORT_LIVE=7496         # TWS live trading port (not used in PAPER mode)
IBKR_CLIENT_ID=1            # Unique client ID — change if running multiple bots
IBKR_TIMEOUT=30

# ── AI Analysis ─────────────────────────────────────────────
# Supports OpenAI (default) or Anthropic. Set AI_ENABLED=false to
# skip AI and trade on strategy signals alone.
AI_ENABLED=false            # Set true once you have a valid API key
AI_PROVIDER=openai          # "openai" or "anthropic"

# OpenAI (recommended — get key from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
AI_MODEL=gpt-4o-mini        # gpt-4o-mini (cheap/fast)  |  gpt-4o (best)

# Anthropic (alternative — get key from console.anthropic.com/settings/keys)
# If using Anthropic: set AI_PROVIDER=anthropic and choose a model below
# ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
# AI_MODEL=claude-sonnet-5

AI_MAX_TOKENS=1024
AI_TIMEOUT=30

# ── Risk Parameters ─────────────────────────────────────────
# These are conservative paper trading defaults. Tune after reviewing backtests.
MAX_OPEN_POSITIONS=3
MAX_POSITION_VALUE_USD=2000     # Max $ value per position
MAX_RISK_PER_TRADE_USD=50       # Max $ risk per trade (stop loss distance * shares)
MAX_DAILY_LOSS_USD=150          # Kill switch triggers if daily P/L drops below this
MAX_DAILY_TRADES=5
MAX_TOTAL_EXPOSURE_PCT=0.50     # Max % of account in open positions
MAX_SPREAD_PCT=0.005            # Reject stocks with bid/ask spread > 0.5%
MIN_VOLUME=500000               # Minimum daily volume to trade
COOLDOWN_AFTER_LOSS_MINUTES=30  # Wait this long after a losing trade

# ── Universe ────────────────────────────────────────────────
# Comma-separated list of symbols the scanner watches.
# Run scripts/scan.py to discover good candidates dynamically.
UNIVERSE=["SPY","QQQ","AAPL","MSFT","NVDA","AMD","META","AMZN","GILD","PLTR","CRWD","TMO","HOOD","FTNT"]

# ── Strategy Parameters ──────────────────────────────────────
EMA_SHORT=20
EMA_LONG=50
RSI_MIN=40
RSI_MAX=70
RELATIVE_VOLUME_MIN=1.2     # Minimum relative volume for intraday signals
MOMENTUM_LOOKBACK=5
ATR_MAX_PCT=0.03            # Max ATR as % of price (3% = normal intraday)

# ── Scanner ─────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=60    # How often to re-scan the universe (seconds)
MAX_CANDIDATES=5            # Top N candidates to run strategy + AI on

# ── AWS (optional — only needed for notifications/cloud deploy) ──────────────
# Leave blank to disable SNS alerts. The trader runs fine without AWS.
AWS_REGION=ap-southeast-1
AWS_SNS_TOPIC_ARN=
# AWS credentials are read from ~/.aws/credentials or env vars below:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── API Dashboard ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false              # true = structured JSON logs; false = readable text
